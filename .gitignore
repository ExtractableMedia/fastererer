# See https://help.github.com/articles/ignoring-files for more about ignoring files

# Ignore bundler config
/.bundle/

# Ignore agent memory and local settings. This repository is public and both hold working context.
/.claude/agent-memory/
/.claude/settings.local.json
/.claude/worktrees/

# Ignore language server and coding assistant caches
/.ruby-lsp/
/.serena/

# Ignore coverage reports
/coverage/

# Ignore built gems
/pkg/
*.gem

# Ignore temporary files and operating system cruft
/tmp/
.DS_Store
